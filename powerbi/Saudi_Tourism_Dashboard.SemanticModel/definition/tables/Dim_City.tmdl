				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"City", type text}, {"City_Raw", type text}, {"Is_Other", type logical}}, "en-US")
