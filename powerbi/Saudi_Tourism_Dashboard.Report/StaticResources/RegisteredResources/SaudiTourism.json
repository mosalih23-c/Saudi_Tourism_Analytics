{
  "name": "SaudiTourism",
  "dataColors": [
    "#0F7B5F",
    "#C8741C",
    "#3A6EA5",
    "#B5475B",
    "#7A6A2E",
    "#5B8C7A",
    "#8A5A9E",
    "#3F7F9A"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A24",
  "tableAccent": "#0F7B5F",
  "good": "#0F7B5F",
  "bad": "#B5475B",
  "neutral": "#C9A44C",
  "maximum": "#0B4D3B",
  "center": "#A8CDBF",
  "minimum": "#EAF4EF",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B4D3B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B4D3B"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A24"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B6458"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B4D3B"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E2D4"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Custom",
            "angle": 90,
            "shadowDistance": 2,
            "shadowBlur": 8,
            "shadowSpread": 0,
            "transparency": 88,
            "color": {
              "solid": {
                "color": "#3D3A2F"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#EEEAE0"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#6B6458"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#1F2A24"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2A24"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#1F2A24"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "linear",
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 4
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0B4D3B"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F4EC"
              }
            }
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#EFE7D2"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0B4D3B"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E8E2D4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B4D3B"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2A24"
              }
            }
          }
        ]
      }
    }
  }
}